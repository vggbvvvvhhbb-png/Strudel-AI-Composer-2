# Контекст сборки: только то, что нужно образу.
# Без этого `COPY . .` тащит в образ node_modules (а на Windows он ещё и
# сломанный в linux-контейнере) и .env с ключами.

node_modules
dist
.git
.github
.sharrowkin
.scratch
eval
corpus
docs
tests

# Секреты в образ попадать не должны.
.env
.env.*
!.env.example

# Банк-исходник Timbre Palette (оригиналы WAV, 74.7 МБ) — импортный слой:
# в рантайме сервер читает только OGG-пресеты из data/timbre/audio/<alias>/.
data/timbre/audio/originals

# Служебное.
server.log
server.log.err
*.log
.vscode
.idea
