eval/results/
eval/results-dry/
eval/ab-pairs.json
eval/ab-results.json

# Корпус кандидатов генерируется: node scripts/build-corpus.mjs
corpus/candidates/*.js

# Человеческие метки: локально, без PII, вне git. Экспорт — GET /api/preference/export,
# удаление — DELETE /api/preference.
server/data/preferences.jsonl

# Реестр пар (нужен для обучения выученной цели) и обученная модель:
