node_modules/
dist/
.sharrowkin/
.env
.env.local
*.log
*.log.*
.DS_Store
Thumbs.db

# Сгенерированный мастер-worklet: собирается из src/audio/worklet/* через
# esbuild (npm run build:worklet). В репозитории исходники, не артефакт.
public/worklets/master-processor.js

# Артефакты проб spike: воспроизводятся командой node tests/spike/probe.mjs
tests/spike/*.out.txt

# Результаты eval-прогонов: генерируются, в репозитории им не место.
# Пара для слепого теста тоже собирается на месте: node eval/run.mjs
eval/results/
eval/results-dry/
eval/ab-pairs.json
eval/ab-results.json

# Корпус кандидатов генерируется: node scripts/build-corpus.mjs
corpus/candidates/*.js

# Человеческие метки: локально, без PII, вне git. Экспорт — GET /api/preference/export,
# удаление — DELETE /api/preference.
server/data/preferences.jsonl

# Реестр пар (нужен для обучения выученной цели) и обученная модель:
# локальные данные владельца, вне git.
server/data/pairs.jsonl
server/data/taste-model.json
server/data/taste-report.json
# Временные рабочие файлы сессий (скрипты, очереди, дампы) — не в git.
.scratch/
# Перенос TEMP/TMP сюда — когда системный диск заполнен (E-041), ворота
# падают на ENOSPC. Здесь только временные файлы запусков — в git не нужны.
.tmp/
__pycache__/
*.pyc

# Бандл рендер-воркера: собирается на этапе сборки образа (npm run build:render).
server/deepdive/render/dist/

# Состояние локального демона: журнал очереди задач и рендеры. Локальные
# данные машины владельца, вне git.
local/.state/

# Аудиофайлы локального пула сэмплов «Охотника» (D-115). Реестр записей
# (data/samples/pool.json) в git идёт, сами звуки — нет.
data/samples/audio/

# Аудио каталога Timbre Palette (D-126, D-130). Манифесты прав и пресетов
# (server/music/data/timbre/) и сами пресеты в git идут: 41 OGG-файл,
# 6.2 МБ, все CC0-1.0 с поштучными паспортами (server/music/data/timbre/
# assets.json). Причина: Dockerfile копирует каталог в образ, а CI
# собирает из чистого checkout — при каталоге вне git сборка падала
# (COPY failed: no such file or directory).
#
# Банк-исходник (originals/, WAV 74.7 МБ) — импортный слой, вне git.
# Порядок правил важен: содержимое каталога исключается, подкаталоги
# с пресетами возвращаются, originals исключается последним.
data/timbre/audio/*
!data/timbre/audio/*/
data/timbre/audio/originals/
