{
  "name": "strudel-ai-composer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-secrets.js",
    "check:presets": "node scripts/check-presets.mjs",
    "check:api": "node scripts/extract-strudel-api.mjs",
    "check:knowledge": "node scripts/check-knowledge.mjs",
    "spike": "node tests/spike/probe.mjs",
    "spike:compose": "node tests/spike/compose-pipeline.probe.mjs",
    "spike:audio": "node tests/spike/audio-api.probe.mjs",
    "spike:browser": "node tests/spike/browser/master-spike.mjs",
    "sync:samples": "node scripts/sync-sample-banks.mjs",
    "validate:loudness": "node scripts/validate-loudness.mjs",
    "eval": "node eval/run.mjs",
    "eval:dry": "node eval/run.mjs --dry",
    "eval:ab": "node eval/analyze-ab.mjs",
    "corpus": "node scripts/build-corpus.mjs"
  },
  "dependencies": {
    "@strudel/web": "1.3.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "lz-string": "^1.5.0",
    "multer": "^2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "ffmpeg-static": "5.2.0",
    "playwright-core": "1.49.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
