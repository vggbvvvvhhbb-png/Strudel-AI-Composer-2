# Скопируйте в .env и вставьте свои значения. Реальные ключи храните только здесь.

# --- Порт и режим ---
PORT=3001
NODE_ENV=development

# --- Провайдеры LLM ---
# Порядок перебора: если провайдер недоступен или вернул пустой ответ,
# запрос уходит следующему. Доступные: openai, groq, ollama, anthropic.
LLM_PROVIDERS=openai

# OpenAI (или любой OpenAI-совместимый прокси): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Резервная модель — используется, если основная недоступна.
OPENAI_FALLBACK_MODEL=

# Groq — быстрый инференс, часто дешевле как «критик» разбора:
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — локальный инференс, без интернета и без оплаты:
# OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Anthropic (Messages API):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Голосовой ввод (необязательный модуль) ---
# Без ключа кнопка микрофона прячется, остальное приложение работает.
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- База знаний RAG (D-134/D-137, сессия «Музыкальный интеллект») ---
# Эмбеддинги: локальная Ollama, nomic-embed-text (Apache-2.0, 768).
# OLLAMA_EMBED_URL приоритетнее OLLAMA_BASE_URL (нативный API без /v1):
# OLLAMA_EMBED_URL=http://localhost:11434
# EMBED_MODEL=nomic-embed-text
# Supabase владельца (ключи NEVER в репо; только здесь локально):
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.<ref>
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_PASSWORD=
