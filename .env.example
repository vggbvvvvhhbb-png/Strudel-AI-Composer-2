# Скопируйте в .env и вставьте свои ключи:
# OpenAI: https://platform.openai.com/api-keys
# Groq:   https://console.groq.com/keys
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# Необязательно: если api.openai.com недоступен напрямую из вашего региона,
# укажите совместимый эндпойнт (например, свой прокси или шлюз OpenAI-совместимого API).
# OPENAI_BASE_URL=https://api.openai.com
# GROQ_BASE_URL=https://api.groq.com
